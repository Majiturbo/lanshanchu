{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanshanChu",
  "mainBinaryName": "LanshanChu",
  "version": "0.1.1",
  "identifier": "com.lanshanchu.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:17531",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "阑珊处",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: https: blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://www.tgcsm.site"
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "阑珊处",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "startMenuFolder": "阑珊处",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis/header.bmp",
        "sidebarImage": "windows/nsis/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "customLanguageFiles": {
          "SimpChinese": "windows/lang/SimpChinese.nsh"
        }
      }
    }
  }
}